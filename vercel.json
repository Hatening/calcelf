{
  "functions": {
    "api/solve.js": {
      "maxDuration": 60
    },
    "api/animation.js": {
      "maxDuration": 60
    },
    "api/animation-plan.js": {
      "maxDuration": 60
    },
    "api/chat.js": {
      "maxDuration": 120
    },
    "api/practice.js": {
      "maxDuration": 180
    },
    "api/grade.js": {
      "maxDuration": 120
    },
    "api/weekly-report.js": {
      "maxDuration": 60
    },
    "api/cron-weekly-report.js": {
      "maxDuration": 120
    },
    "api/feedback.js": {
      "maxDuration": 30
    },
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-weekly-report",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron-distill",
      "schedule": "30 14 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ]
}